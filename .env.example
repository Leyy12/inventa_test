# Copy this file to .env and fill it in:   cp .env.example .env
# Never commit .env — it holds your API key.

# ── InventaAPI ────────────────────────────────────────────
# Your API key from https://inventaapi.shop → Dashboard → API Keys.
# The POS shows exactly the products linked to this key.
INVENTA_API_KEY=paste-your-inventa-api-key-here
INVENTA_API_URL=https://inventaapi.shop

# ── Supabase (where the POS keeps prices, stock and sales) ─
# Supabase dashboard → Project Settings → API. Leave empty to use a local file instead.
SUPABASE_URL=https://ztljiycedvafdqpuywkc.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# QuickPOS settings. Run `npm run setup` to create your own .env from this file,
# then paste your keys into .env (not into this file). .env is never uploaded to GitHub.

# ── InventaAPI keys: one per store ────────────────────────
# Get each key from https://inventaapi.shop → Dashboard → API Keys.
# Each store sells exactly the products linked to its key.
INVENTA_API_KEY_GROCERY=
INVENTA_API_KEY_PHARMACY=
INVENTA_API_KEY_HARDWARE=

INVENTA_API_URL=https://inventaapi.shop

# ── Supabase: where prices, stock and sales are saved ─────
# These two are not secret (the publishable key is meant to be public).
# Leave them empty to save to a local file instead.
SUPABASE_URL=https://ztljiycedvafdqpuywkc.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xTVbGAv5O1ahDplNx64LOg_nMF29CH2
